{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.cjs"
    },
    {
      "source": "/send-otp",
      "destination": "/api/index.cjs"
    },
    {
      "source": "/verify-otp",
      "destination": "/api/index.cjs"
    },
    {
      "source": "/invoices/(.*)",
      "destination": "/api/index.cjs"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
