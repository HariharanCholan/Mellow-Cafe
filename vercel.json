{
  "version": 2,
  "builds": [
    {
      "src": "api/index.cjs",
      "use": "@vercel/node"
    },
    {
      "src": "Client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.cjs"
    },
    {
      "source": "/send-otp",
      "destination": "/api/index.cjs"
    },
    {
      "source": "/verify-otp",
      "destination": "/api/index.cjs"
    },
    {
      "source": "/invoices/(.*)",
      "destination": "/api/index.cjs"
    },
    {
      "source": "/(assets/.*)",
      "destination": "/Client/$1"
    },
    {
      "source": "/([^.]*)",
      "destination": "/Client/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/Client/$1"
    }
  ]
}
