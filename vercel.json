{
  "version": 2,
  "builds": [
    {
      "src": "api/index.cjs",
      "use": "@vercel/node"
    },
    {
      "src": "Client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.cjs"
    },
    {
      "src": "/send-otp",
      "dest": "/api/index.cjs"
    },
    {
      "src": "/verify-otp",
      "dest": "/api/index.cjs"
    },
    {
      "src": "/invoices/(.*)",
      "dest": "/api/index.cjs"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/Client/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/Client/$1"
    }
  ]
}
